# Copy to backend/.env for local overrides (pydantic-settings loads .env
# automatically per backend/src/whisperlab/config.py's env_file=".env").
# All variables must use the WHISPERLAB_ prefix -- see config.py's
# env_prefix="WHISPERLAB_". Unprefixed names (DATABASE_URL, etc.) are
# silently ignored by the app. Field list below matches config.py's
# Settings class exactly -- fields not listed there do nothing.

# --- Postgres: local docker-compose default ---------------------------
WHISPERLAB_DATABASE_URL=postgresql+asyncpg://whisperlab:whisperlab@127.0.0.1:5432/whisperlab

# --- Postgres: Neon free tier (use instead of the line above) --------------
# Get this from the Neon console (Connection Details). Neon's dashboard gives
# you a psycopg-style URL with `?sslmode=require`; for this app's asyncpg
# driver, SQLAlchemy expects `?ssl=require` instead -- translate it, or the
# connection will fail with an unrecognized-parameter error from asyncpg.
# Verify against your actual Neon connection string before relying on this.
# WHISPERLAB_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<endpoint>.neon.tech/<dbname>?ssl=require

WHISPERLAB_REDIS_URL=redis://127.0.0.1:6379/0

# --- Object storage: Backblaze B2 (S3-compatible), free tier ---------------
# NOTE: as of this writing, no code in backend/src actually uses these MinIO
# settings (no boto3/minio/s3 client exists anywhere in the codebase -- they
# are config fields with no consumer yet). Set these so they're ready once an
# S3 client is implemented; they do nothing until then.
# B2's S3-compatible endpoint format: s3.<region>.backblazeb2.com
WHISPERLAB_MINIO_ENDPOINT=127.0.0.1:9000
# WHISPERLAB_MINIO_ENDPOINT=s3.us-west-004.backblazeb2.com
WHISPERLAB_MINIO_ACCESS_KEY=whisperlab
WHISPERLAB_MINIO_SECRET_KEY=whisperlab
WHISPERLAB_MINIO_BUCKET=whisperlab
WHISPERLAB_MINIO_USE_SSL=false

WHISPERLAB_SECRET_KEY=change-me-in-production
WHISPERLAB_ENABLE_EXECUTION=false
WHISPERLAB_EXECUTION_TIMEOUT_SECONDS=60
